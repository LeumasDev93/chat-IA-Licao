# Variáveis de ambiente para desenvolvimento local

# Chave secreta para o cron job (obrigatória no Vercel)
CRON_SECRET=sua_chave_secreta_aqui

# URL do Vercel (será definida automaticamente no deploy)
VERCEL_URL=

# Google Gemini API (obrigatória para o chat) — SOMENTE no servidor, sem prefixo NEXT_PUBLIC_
GEMINI_API_KEY=sua_chave_gratuita_do_gemini
GEMINI_IMAGE_API_KEY=sua_chave_paga_para_imagens

# Rate limiting do endpoint de chat (opcional)
CHAT_RATE_LIMIT=15
CHAT_RATE_WINDOW_MS=60000

# Web Push / Notificações (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua_chave_publica_vapid
VAPID_PRIVATE_KEY=sua_chave_privada_vapid
VAPID_SUBJECT=mailto:contato@seudominio.com

# Supabase Configuration - Projeto: ltzbopxmezdanyjejfpy
# Obtenha estas chaves em: https://supabase.com/dashboard/project/ltzbopxmezdanyjejfpy/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://ltzbopxmezdanyjejfpy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima_do_supabase
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_do_supabase

# Configurações do Firebase (se aplicável)
FIREBASE_PROJECT_ID=seu_projeto_firebase
FIREBASE_PRIVATE_KEY=sua_chave_privada_firebase
FIREBASE_CLIENT_EMAIL=seu_email_cliente_firebase
